---
import { nav, profile } from '../data/site';

interface Props {
  // The home page has its own index, so the header there is just the theme toggle.
  home?: boolean;
}

const { home = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class:list={['site-header', { home }]}>
  <div class="wrap bar">
    {
      !home && (
        <a href="/" class="brand">
          {profile.name}
        </a>
      )
    }
    <button class="theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <mask id="moon-cut">
          <rect width="24" height="24" fill="white"></rect>
          <circle class="cut" cx="24" cy="4" r="7" fill="black"></circle>
        </mask>
        <circle class="body" cx="12" cy="12" r="5" fill="currentColor" mask="url(#moon-cut)"></circle>
        <g class="rays">
          <path d="M12 1.8v2M12 20.2v2M4.8 4.8l1.4 1.4M17.8 17.8l1.4 1.4M1.8 12h2M20.2 12h2M4.8 19.2l1.4-1.4M17.8 6.2l1.4-1.4"></path>
        </g>
      </svg>
    </button>
    {
      !home && (
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
    };

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduced) return apply();

    // Grow the new theme as a circle from the centre of the toggle.
    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    document.startViewTransition(apply).ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
        { duration: 650, easing: 'cubic-bezier(0.6, 0, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
  });
</script>

<style>
  .site-header {
    padding-top: 1.75rem;
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'brand theme'
      'nav nav';
    align-items: center;
    row-gap: 1.1rem;
  }

  .home .bar {
    grid-template-areas: '. theme';
  }

  .brand {
    grid-area: brand;
    justify-self: start;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .theme {
    grid-area: theme;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }

  .theme:hover {
    color: var(--ink);
    border-color: var(--line-strong);
    background: var(--raised);
  }

  /* Sun in light mode; the cut-out slides in to make a moon in dark mode. */
  .theme svg {
    transition: transform 0.6s var(--ease);
  }

  .theme .body {
    transition: r 0.45s var(--ease);
  }

  .theme .cut {
    transition: cx 0.45s var(--ease), cy 0.45s var(--ease);
  }

  .theme .rays {
    transform-origin: center;
    transition: opacity 0.3s, transform 0.5s var(--ease);
  }

  :global([data-theme='dark']) .theme svg {
    transform: rotate(360deg);
  }

  :global([data-theme='dark']) .theme .body {
    r: 8;
  }

  :global([data-theme='dark']) .theme .cut {
    cx: 17;
    cy: 7;
  }

  :global([data-theme='dark']) .theme .rays {
    opacity: 0;
    transform: scale(0.5) rotate(45deg);
  }

  nav {
    grid-area: nav;
    min-width: 0;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, #000 85%, transparent);
  }

  nav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    position: relative;
    padding: 0.5rem 0 0.85rem;
    font-size: 14.5px;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.2s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1.5px;
    background: var(--ink);
  }

  @media (min-width: 760px) {
    .bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'brand nav theme';
      column-gap: 2.25rem;
    }

    .home .bar {
      grid-template-areas: '. . theme';
    }

    nav {
      border-bottom: 0;
      justify-self: end;
      mask-image: none;
    }

    nav ul {
      gap: 1.75rem;
    }

    nav a {
      padding: 0.4rem 0;
    }

    nav a[aria-current='page']::after {
      bottom: -4px;
      left: 50%;
      right: auto;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      transform: translateX(-50%);
    }
  }
</style>
