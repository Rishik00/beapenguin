---
import Base from '../../layouts/Base.astro';
import { fmtDate, getExperimentList } from '../../utils';

const experiments = await getExperimentList();
---

<Base title="Experiments" description="I try to answer my questions with experiments.">
  <header class="page-head">
    <h1>Experiments</h1>
    <p>I try to answer my questions with experiments.</p>
  </header>

  <ul class="rows list">
    {
      experiments.map((e) => (
        <li>
          <a class="row exp" href={e.href}>
            <span class="meta">{fmtDate(e.date)}</span>
            <span class="title">{e.title}</span>
            <span class="arrow">→</span>
            <p class="desc">{e.summary}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .list {
    border-top: 1px solid var(--line);
  }

  .exp {
    padding-block: 1.4rem;
  }

  .exp .title {
    font-size: 1.05rem;
  }

  .exp .desc {
    max-width: 40rem;
    margin-top: 0.25rem;
  }

</style>
