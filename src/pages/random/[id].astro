---
import Article from '../../components/Article.astro';
import { getPosts } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts('random');
  return posts.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
---

<Article {...Astro.props} base="/random" label="Random" />
