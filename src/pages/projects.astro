---
import Base from '../layouts/Base.astro';
import { archive, builds, projects } from '../data/site';

const tools = projects.filter((p) => p.kind === 'Tool');
const groups = [
  { title: 'Research', items: projects.filter((p) => p.kind === 'Research') },
  { title: 'Libraries', items: projects.filter((p) => p.kind === 'Library') },
];
const linkOf = (p: (typeof projects)[number]) => p.live ?? p.href;
---

<Base title="Projects" description="Research, libraries, tools and small builds.">
  <header class="page-head">
    <h1>Projects</h1>
    <p>Research, libraries pulled out of research code, tools, and things built for fun.</p>
  </header>

  {
    groups.map((g) => (
      <section class="section">
        <div class="section-title">
          <h2>{g.title}</h2>
        </div>
        <div class="cards">
          {g.items.map((p) => {
            const href = linkOf(p);
            const Tag = href ? 'a' : 'div';
            return (
              <Tag class="card" href={href}>
                <div class="card-top">
                  <h3>{p.name}</h3>
                  {href && <span class="hint">↗</span>}
                </div>
                <p>{p.blurb}</p>
                <ul class="chips">
                  {p.stack.map((s) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
              </Tag>
            );
          })}
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="section-title"><h2>Small builds and solutions</h2></div>
    <ul class="rows">
      {
        builds.map((b) => {
          const Tag = b.href ? 'a' : 'div';
          return (
            <li>
              <Tag class="row" href={b.href}>
                <span class="meta">{b.kind}</span>
                <span class="title">{b.title}</span>
                <span class="arrow">↗</span>
                <p class="desc">{b.blurb}</p>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-title"><h2>Earlier work</h2></div>
    <ul class="rows">
      {
        archive.map((a) => (
          <li>
            <a class="row" href={a.href}>
              <span class="meta">{a.year}</span>
              <span class="title">{a.name}</span>
              <span class="arrow">↗</span>
              <p class="desc">{a.blurb}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-title"><h2>Tools</h2></div>
    <div class="cards tools">
      {
        tools.map((p) => {
          const href = linkOf(p);
          const Tag = href ? 'a' : 'div';
          return (
            <Tag class="card" href={href}>
              {p.image && (
                <img class="shot" src={p.image} alt={`Screenshot of ${p.name}`} loading="lazy" />
              )}
              <div class="card-top">
                <h3>{p.name}</h3>
                <span class="hint">{href ? (p.live ? 'Live ↗' : 'Code ↗') : 'Private'}</span>
              </div>
              <p>{p.blurb}</p>
              <ul class="chips">
                {p.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            </Tag>
          );
        })
      }
    </div>
  </section>
</Base>

<style>
  .tools {
    align-items: start;
  }

  .shot {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    background: #000;
    border-radius: 4px;
  }
</style>
